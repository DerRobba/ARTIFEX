[Unit]
Description=ARTIFEX touch display (cage Wayland kiosk + Chromium)
After=systemd-user-sessions.service artifex.service plymouth-quit-wait.service seatd.service
Wants=artifex.service
Conflicts=getty@tty1.service

[Service]
User=@USER@
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=WLR_LIBINPUT_NO_DEVICES=1
# Wait until the ARTIFEX backend answers, then show the UI fullscreen.
ExecStartPre=/bin/sh -c 'for i in $(seq 60); do curl -fs http://127.0.0.1:8080/api/health >/dev/null && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/bin/cage -d -s -- @CHROMIUM@ --kiosk --noerrdialogs --disable-infobars --no-first-run \
  --disable-translate --disable-features=TranslateUI,Translate --overscroll-history-navigation=0 \
  --disable-pinch --check-for-update-interval=31536000 --password-store=basic \
  --ozone-platform=wayland --enable-features=OverlayScrollbar --touch-events=enabled \
  --user-data-dir=@HOME@/.config/artifex-kiosk "http://127.0.0.1:8080/?kiosk"
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
